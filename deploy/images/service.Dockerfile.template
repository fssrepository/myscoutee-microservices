# Generated for @SERVICE@ from assemblies.json. Domain source is never copied here.
ARG RUNTIME_IMAGE=@RUNTIME_IMAGE@
FROM ${RUNTIME_IMAGE} AS layers
WORKDIR /extract
COPY myscoutee-@SERVICE@.jar application.jar
RUN java -Djarmode=tools -jar application.jar extract --layers --destination extracted

FROM ${RUNTIME_IMAGE}
ARG BACKEND_REVISION
ARG BACKEND_DIRTY
LABEL com.myscoutee.task="@ISSUE@" \
      com.myscoutee.assembly="@SERVICE@" \
      org.opencontainers.image.revision="${BACKEND_REVISION}" \
      com.myscoutee.backend-dirty="${BACKEND_DIRTY}"
ENV SPRING_PROFILES_ACTIVE=prod \
    JAVA_TOOL_OPTIONS="-Xms64m -Xmx@HEAP_MIB@m -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError"
WORKDIR /app
COPY --from=layers --chown=10001:10001 /extract/extracted/dependencies/ ./
COPY --from=layers --chown=10001:10001 /extract/extracted/spring-boot-loader/ ./
COPY --from=layers --chown=10001:10001 /extract/extracted/snapshot-dependencies/ ./
COPY --from=layers --chown=10001:10001 /extract/extracted/application/ ./
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/application.jar"]
